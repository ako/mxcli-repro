-- Reproduction: view entity ID column without an alias
-- Step 1 — the ordinary model the view reads from.
--
-- NOTE: the entity is SalesOrder, not Order. "Order" is an OQL reserved word
-- (ORDER BY), so `from Repro.Order as o` fails mx check with CE0174 unless it is
-- quoted. That is a separate issue and would muddy this reproduction.

CREATE MODULE Repro;

@position(100, 100)
CREATE PERSISTENT ENTITY Repro.Customer (
  Name: string(100)
);

@position(100, 300)
CREATE PERSISTENT ENTITY Repro.SalesOrder (
  OrderNumber: string(20),
  OrderDate: datetime,
  Amount: decimal
);

CREATE ASSOCIATION Repro.SalesOrder_Customer
  FROM Repro.SalesOrder TO Repro.Customer
  TYPE Reference
  OWNER Default;
