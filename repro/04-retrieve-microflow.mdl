-- Reproduction: view entity ID column without an alias
-- Step 4a — the microflow under test.
--
-- Creates its own data, reads the view entity, then follows
-- Repro.OrderView_SalesOrder back to the source object. If the un-aliased ID
-- column leaves the association unusable at runtime, this is where it shows.

CREATE OR MODIFY MICROFLOW Repro.ACT_RetrieveOverViewAssociation ()
  RETURNS String
BEGIN
  $Customer = CREATE Repro.Customer (
    Name = 'Acme BV'
  );
  COMMIT $Customer;

  $Order = CREATE Repro.SalesOrder (
    OrderNumber = 'SO-1',
    Amount = 42.50,
    Repro.SalesOrder_Customer = $Customer
  );
  COMMIT $Order;

  RETRIEVE $Views FROM Repro.OrderView;
  $View = HEAD($Views);

  -- The line under test: follow the association the ID column created.
  RETRIEVE $Source FROM $View/Repro.OrderView_SalesOrder;

  RETURN $Source/OrderNumber;
END;
